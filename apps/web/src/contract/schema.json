    "TaskInputs": {
      "additionalProperties": false,
      "description": "The work payload.",
      "properties": {
        "extract_schema": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extract Schema"
        },
        "query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
