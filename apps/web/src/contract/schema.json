    "RetrySpec": {
      "additionalProperties": false,
      "description": "Retry policy; honors the SDK ``retry_after`` from mapped errors by default.",
      "properties": {
        "honor_retry_after": {
          "default": true,
          "title": "Honor Retry After",
          "type": "boolean"
        },
        "max": {
          "default": 2,
          "title": "Max",
          "type": "integer"
        }
      },
      "title": "RetrySpec",
      "type": "object"
    },
    "SectionDef": {
      "additionalProperties": false,
      "description": "A labelled sub-region of the graveyard: bounds + a workstation pool + a role\n(default behavior) + task-routing rules. Declared as DATA alongside the map.",
      "properties": {
        "accepts": {
          "items": {
            "type": "string"
          },
          "title": "Accepts",
          "type": "array"
        },
        "bounds": {
          "$ref": "#/$defs/Bounds"
        },
        "capacity": {
          "default": 1,
          "minimum": 0,
          "title": "Capacity",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "palette": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Palette"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "routes_to": {
          "items": {
            "type": "string"
          },
          "title": "Routes To",
          "type": "array"
        },
        "workstation_types": {
          "items": {
            "type": "string"
          },
          "title": "Workstation Types",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "bounds",
        "role"
      ],
      "title": "SectionDef",
      "type": "object"
    },
