        "h": {
          "title": "H",
          "type": "integer"
        },
        "w": {
          "title": "W",
          "type": "integer"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "w",
        "h"
      ],
      "title": "Bounds",
      "type": "object"
    },
    "BrowserEvent": {
      "additionalProperties": false,
      "description": "A browser.* session event.",
      "properties": {
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "session_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "BrowserEvent",
      "type": "object"
    },
    "BrowserSession": {
      "description": "A real GhostCrawl browser session bound to a ghost/task.",
      "properties": {
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Engine"
        },
        "ghost_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
