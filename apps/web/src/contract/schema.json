            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urls"
        }
      },
      "title": "TaskInputs",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "description": "A declarative, parameterized task. Emittable by non-coders and AI; validated\nagainst this schema + the named behavior's own ``paramSchema`` at assign time.",
      "properties": {
        "behavior": {
          "title": "Behavior",
          "type": "string"
        },
        "concurrency": {
          "default": 5,
          "maximum": 50,
          "minimum": 1,
          "title": "Concurrency",
          "type": "integer"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "identities": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identities"
        },
        "inputs": {
          "$ref": "#/$defs/TaskInputs"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "retry": {
          "$ref": "#/$defs/RetrySpec"
        },
        "target": {
          "$ref": "#/$defs/TaskTarget"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title",
        "behavior"
      ],
      "title": "TaskSpec",
      "type": "object"
    },
    "TaskTarget": {
      "additionalProperties": false,
      "description": "Where the work runs (dual-target: cloud OR self-host).",
      "properties": {
        "gc_target": {
          "default": "cloud",
          "enum": [
            "cloud",
            "selfhost"
          ],
          "title": "Gc Target",
          "type": "string"
        },
        "profile": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Profile"
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
