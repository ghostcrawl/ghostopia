      "additionalProperties": false,
      "description": "A lightweight reference to a section a ghost belongs to (role + optional bounds/\nroster), passed into ``BehaviorContext`` without the full ``SectionDef``.",
      "properties": {
        "bounds": {
          "anyOf": [
            {
              "$ref": "#/$defs/Bounds"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "roster": {
          "items": {
            "type": "string"
          },
          "title": "Roster",
          "type": "array"
        }
      },
      "required": [
        "id",
        "role"
      ],
      "title": "SectionRef",
      "type": "object"
    },
    "Task": {
      "description": "A unit of work assigned to a ghost (mission fan-out). ``kind`` routes it to a\nsection; ``behavior_hint`` can request a specific behavior (role-resolution \u00a7B).",
      "properties": {
        "behavior_hint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Behavior Hint"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "inputs": {
          "additionalProperties": true,
          "title": "Inputs",
          "type": "object"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "mission_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
