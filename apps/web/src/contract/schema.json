          "default": null,
          "title": "Record"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "task_id"
