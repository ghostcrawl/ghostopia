{
  "$defs": {
    "Agent": {
      "description": "An AgentProvider instance (deterministic runner or LLM brain), behind the seam.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "default": "deterministic",
          "enum": [
            "deterministic",
            "llm"
          ],
          "title": "Kind",
          "type": "string"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        }
      },
      "required": [
        "id"
      ],
      "title": "Agent",
      "type": "object"
    },
    "AgentEvent": {
      "additionalProperties": false,
      "description": "A normalized event from an AgentProvider (deterministic runner OR LLM).",
      "properties": {
        "agent_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "AgentEvent",
      "type": "object"
    },
    "Bounds": {
      "description": "A tile rectangle on the map (section bounds / region).",
