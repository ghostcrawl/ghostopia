          ],
          "default": null,
          "title": "Direction"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "properties": {
          "additionalProperties": true,
          "title": "Properties",
          "type": "object"
        },
        "type": {
          "title": "Type",
          "type": "string"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "type",
        "x",
        "y"
      ],
