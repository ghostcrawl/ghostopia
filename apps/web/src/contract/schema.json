      },
      "required": [
        "session_id"
      ],
      "title": "BrowserSession",
      "type": "object"
    },
    "Envelope": {
      "additionalProperties": false,
      "description": "The normalized envelope: ``{protocol_version, type, ghost_id, ts, payload}``.",
      "properties": {
        "ghost_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ghost Id"
        },
        "payload": {
          "default": null,
          "title": "Payload"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "integer"
        },
        "ts": {
          "title": "Ts",
          "type": "number"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "protocol_version",
        "type",
        "ts"
      ],
      "title": "Envelope",
      "type": "object"
    },
    "ErrorEvent": {
      "additionalProperties": false,
      "description": "A mapped SDK error surfaced to the world (GHOSTCRAWL_INTEGRATION error map).",
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detail"
        },
        "retry_after": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "Ghost": {
      "description": "A visual worker entity. Differentiated by name/section/task/location/UI \u2014\nNOT by RPG class (BRIEF \u00a722/\u00a730).",
      "properties": {
        "behavior_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Behavior Override"
        },
        "home_grave": {
          "title": "Home Grave",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "section": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "state": {
          "$ref": "#/$defs/GhostState",
          "default": "IDLE"
        },
        "task_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "id",
        "name",
        "home_grave"
      ],
      "title": "Ghost",
      "type": "object"
    },
    "GhostCommand": {
      "additionalProperties": false,
      "description": "A command issued to a ghost (management/driver \u2192 runtime).",
      "properties": {
        "args": {
          "additionalProperties": true,
          "title": "Args",
          "type": "object"
        },
        "ghost_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ghost Id"
        },
        "kind": {
          "minLength": 1,
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "GhostCommand",
      "type": "object"
    },
    "GhostEvent": {
      "additionalProperties": false,
      "description": "A normalized ghost/browser/task/result event (the payload envelopes carry).",
      "properties": {
        "ghost_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ghost Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "type": {
          "minLength": 1,
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "GhostEvent",
      "type": "object"
    },
    "GhostState": {
      "description": "The authoritative coarse lifecycle FSM (server-owned; client interpolates).",
      "enum": [
        "IDLE",
        "RECEIVING_TASK",
        "WALKING",
        "AT_WORKSTATION",
        "OPENING_BROWSER",
        "NAVIGATING",
        "SEARCHING",
        "READING",
        "SCROLLING",
        "EXTRACTING",
        "PROCESSING",
        "WAITING",
        "RETRYING",
        "ERROR",
        "COMPLETED",
        "RETURNING_HOME"
      ],
      "title": "GhostState",
      "type": "string"
    },
    "Mission": {
      "description": "A named collection of tasks (the '500 companies' fan-out).",
      "properties": {
        "done": {
          "default": 0,
          "title": "Done",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "task_ids": {
          "items": {
            "type": "string"
          },
          "title": "Task Ids",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "total": {
          "default": 0,
          "title": "Total",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "title"
      ],
      "title": "Mission",
      "type": "object"
    },
    "MissionSpec": {
      "additionalProperties": false,
      "description": "A named collection of tasks (the '500 companies' fan-out).",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "tasks": {
          "items": {
            "$ref": "#/$defs/TaskSpec"
          },
          "title": "Tasks",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "title": "MissionSpec",
      "type": "object"
    },
    "Point": {
      "description": "A pixel/tile coordinate.",
      "properties": {
        "x": {
          "title": "X",
