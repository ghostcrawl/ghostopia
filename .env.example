# ghostopia — example environment.
#
# Copy this file to `.env`, fill in the three required values, then run `make run`.
# The server reads this file at boot; the browser UI never sees these values.

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────────────────────

# Your GhostCrawl key. Stays on the server; never sent to the browser.
GHOSTOPIA_GC_TOKEN=

# GhostCrawl endpoint. Cloud: https://api.ghostcrawl.io
# Self-host: http://localhost:47700 (or your own URL)
GHOSTOPIA_GC_BASE_URL=https://api.ghostcrawl.io

# Secret used to sign the short-lived UI token. Use `openssl rand -hex 32`.
GHOSTOPIA_JWT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL — sensible defaults
# ─────────────────────────────────────────────────────────────────────────────

# Where the local results database (SQLite) lives.
# GHOSTOPIA_DB_PATH=ghostopia.sqlite

# Browser engine used for sessions (default: chrome).
# GHOSTOPIA_ENGINE=chrome

# Optional extraction model for pages with no machine-readable product data.
# Leave blank to run fully on GhostCrawl's own structured extraction.
# GHOSTOPIA_BYO_EXTRACT_KEY=
# Provider: anthropic | openai | openai_compat | google
# GHOSTOPIA_BYO_EXTRACT_TYPE=anthropic
# Model id (a default is chosen per provider type).
# GHOSTOPIA_BYO_EXTRACT_MODEL=
# Base URL — only for openai / openai_compat.
# GHOSTOPIA_BYO_EXTRACT_BASE_URL=

# Optional LLM key for the model-backed agent path (server-side only).
# ANTHROPIC_API_KEY=

# Optional JSON map of named GhostCrawl targets. Not needed for one endpoint.
# GHOSTOPIA_TARGETS=

# Where runtime-authored departments are saved (defaults next to the database).
# GHOSTOPIA_AUTHORED_SECTIONS_PATH=

# Where a customized world map is loaded from (defaults to the shipped map).
# GHOSTOPIA_MAP_PATH=

# Where the built web UI is served from (defaults to apps/web/dist).
# GHOSTOPIA_WEB_DIST=

# Tuning knobs (positive integers).
# GHOSTOPIA_GHOSTS_PER_SECTION=3
# GHOSTOPIA_LIVE_BROWSER_GHOSTS=2
# GHOSTOPIA_WORKFORCE_MAX_CONCURRENT=
# GHOSTOPIA_IDLE_TEARDOWN_GRACE_S=
