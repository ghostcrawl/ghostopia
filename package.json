{
  "name": "ghostopia-frontend",
  "private": true,
  "type": "module",
  "description": "ghostopia \u2014 thin TypeScript/PixiJS frontend (npm workspace). Renders server-authoritative state; never imports the GhostCrawl SDK or any credential.",
  "workspaces": [
    "apps/web",
    "packages/ghost-renderer",
    "packages/ghost-art"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test:unit": "vitest run --passWithNoTests",
    "gen:types": "python3 scripts/gen_ts_types.py"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "vite": "^8.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^25.0.0",
    "json-schema-to-typescript": "^15.0.0"
  }
}
