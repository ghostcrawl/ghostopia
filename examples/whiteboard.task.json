{
  "title": "5 ghosts draw a shape together",
  "behavior": "whiteboard_draw",
  "target": { "gc_target": "cloud", "section": "canvas" },
  "concurrency": 5,
  "params": {
    "kind": "draw",
    "step_px": 12.0,
    "strokes": [
      [ { "x": 120, "y": 200 }, { "x": 300, "y": 260 } ],
      [ { "x": 300, "y": 260 }, { "x": 300, "y": 120 } ],
      [ { "x": 300, "y": 120 }, { "x": 120, "y": 120 } ],
      [ { "x": 120, "y": 120 }, { "x": 120, "y": 200 } ],
      [ { "x": 120, "y": 200 }, { "x": 300, "y": 120 } ]
    ]
  },
  "inputs": { "urls": ["https://a-drawing-site.example"] }
}
